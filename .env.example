# Copy to `.env` and fill in. The benchmark runs entirely on local Docker
# by default; the values below only matter if you point at hosted DBs.

# pgvector
PGVECTOR_DSN=postgresql://bench:bench@localhost:5433/bench

# Qdrant
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=

# LanceDB (embedded; just a path)
LANCEDB_PATH=./data/lancedb

# Chroma (embedded by default)
CHROMA_PATH=./data/chroma

# Hugging Face cache (so re-runs don't re-download embedding models)
HF_HOME=./data/.hf-cache
SENTENCE_TRANSFORMERS_HOME=./data/.hf-cache/sentence-transformers
